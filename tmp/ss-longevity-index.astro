---
import Layout from '../../layouts/LayoutLongevity.astro';

const structuredData = [
  {
    '@type': 'WebPage',
    name: 'Longevity – Natural Vitality for Every Stage of Life',
    description: 'Food, Ayurveda, and daily habits for a longer, steadier life, practical, evidence-aware, and rooted in Indian tradition.',
    url: 'https://www.thesecondspring.org/longevity',
  },
];
---

<Layout
  title="Longevity – Natural Vitality for Every Stage of Life"
  description="Food, Ayurveda, and daily habits for a longer, steadier life. Practical, evidence-aware, and rooted in Indian tradition."
  structuredData={structuredData}
>

  <!-- HERO -->
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-content">
        <span class="eyebrow">For Every Stage of Life</span>
        <h1>Small habits, decades of difference.</h1>
        <p class="hero-sub">Longevity isn't a supplement stack or a biohacking routine. It's what you eat, how you move, how you sleep, and how you manage stress, done consistently, for decades. Ayurvedic wisdom and modern evidence, together.</p>
        <div class="hero-actions">
          <a href="https://wa.me/919266032660" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">Talk to Us on WhatsApp</a>
          <a href="#pillars" class="btn btn-outline">Explore the pillars →</a>
        </div>
        <p class="hero-trust">Private · No fads · Rooted in Indian tradition</p>
      </div>
    </div>
  </section>

  <!-- REASSURANCE -->
  <section class="section">
    <div class="container reassure-inner">
      <h2>Longevity Isn't Complicated</h2>
      <p class="reassure-body">Most longevity advice online is either extreme (expensive supplements, rigid protocols) or vague ("eat healthy, sleep well"). Neither actually helps you build habits that last.</p>
      <p class="reassure-body"><strong>What works is simpler, and it's been practiced in India for generations.</strong> Real food, daily movement, a consistent rhythm, and time-tested plant-based remedies, applied consistently rather than perfectly.</p>
    </div>
  </section>

  <!-- PILLARS -->
  <section id="pillars" class="section section-dark">
    <div class="container">
      <span class="label-light">The Foundations</span>
      <h2 class="dark-title">Four Things That Actually Move the Needle</h2>
      <div class="pillars-grid">
        <div class="pillar-box">
          <div class="pillar-icon">🍛</div>
          <h3 class="pillar-title">Food as medicine</h3>
          <p class="pillar-desc">Whole, seasonal, minimally processed food, the Ayurvedic principle of eating according to your constitution and the season, backed by modern nutrition science.</p>
        </div>
        <div class="pillar-box">
          <div class="pillar-icon">🚶</div>
          <h3 class="pillar-title">Daily movement</h3>
          <p class="pillar-desc">Not necessarily the gym. Walking, yoga, strength work, consistent movement matters more than intensity for long-term healthspan.</p>
        </div>
        <div class="pillar-box">
          <div class="pillar-icon">🌙</div>
          <h3 class="pillar-title">Rhythm & sleep</h3>
          <p class="pillar-desc">Ayurveda's dinacharya (daily routine) and consistent sleep timing both point to the same thing, your body thrives on rhythm, not randomness.</p>
        </div>
        <div class="pillar-box">
          <div class="pillar-icon">🧘</div>
          <h3 class="pillar-title">Mind & stress</h3>
          <p class="pillar-desc">Chronic stress accelerates ageing at a cellular level. Breathwork, meditation, and community connection are not optional extras, they're foundational.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- APPROACH -->
  <section class="section section-mid">
    <div class="container">
      <div class="section-header center">
        <span class="section-label">Our Approach</span>
        <h2 class="section-title">Traditional Wisdom, Held to Modern Evidence</h2>
      </div>
      <div class="approach-grid">
        <div class="approach-card">
          <h3>Ayurvedic</h3>
          <p>Time-tested practices around diet, herbs, and daily rhythm, drawn from a tradition that has observed the human body for thousands of years.</p>
        </div>
        <div class="approach-card">
          <h3>Evidence-aware</h3>
          <p>We check traditional claims against what current research actually shows, and we say so clearly when the evidence is mixed or still developing.</p>
        </div>
        <div class="approach-card">
          <h3>India-rooted</h3>
          <p>Built around Indian food, Indian routines, and Indian access to care, not a Western wellness template with the units converted.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="cta-section">
    <div class="container">
      <div class="cta-inner">
        <h2 class="cta-title">Start With One Habit</h2>
        <p class="cta-desc">You don't need to overhaul your life this week. Talk to us about where to start.</p>
        <a href="https://wa.me/919266032660" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">Talk to Us on WhatsApp →</a>
        <p class="cta-fine">Private · Not medical advice · Rooted in Indian tradition</p>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* HERO */
  .hero { padding: 5rem 0 4rem; border-bottom: 1.5px solid var(--line); }
  .hero-content { max-width: 640px; }
  .eyebrow {
    display: inline-block; font-size: .76rem; font-weight: 700; letter-spacing: .1em;
    text-transform: uppercase; color: var(--accent-deep); background: var(--accent-pale);
    padding: .4rem 1rem; border-radius: 100px; margin-bottom: 1.5rem;
  }
  .hero h1 {
    font-family: 'Lora', serif; font-size: clamp(2.1rem, 5vw, 3.1rem); font-weight: 700;
    line-height: 1.18; letter-spacing: -.01em; margin-bottom: 1.25rem;
  }
  .hero-sub { font-size: 1.05rem; color: var(--ink-soft); line-height: 1.75; margin-bottom: 2rem; max-width: 540px; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.5rem; }
  .hero-trust { font-size: .85rem; color: var(--ink-muted); }

  .section { padding: 5rem 0; }
  .section-header.center { text-align: center; max-width: 640px; margin: 0 auto 3rem; }
  .section-label {
    display: inline-block; font-size: .76rem; font-weight: 700; letter-spacing: .1em;
    text-transform: uppercase; color: var(--accent-deep); margin-bottom: .85rem;
  }
  .section-title { font-family: 'Lora', serif; font-size: clamp(1.6rem, 3vw, 2.1rem); font-weight: 700; line-height: 1.25; }

  /* REASSURANCE */
  .reassure-inner { max-width: 640px; text-align: center; }
  .reassure-inner h2 { font-family: 'Lora', serif; font-size: 2rem; font-weight: 700; margin-bottom: 1.25rem; }
  .reassure-body { font-size: 1.02rem; color: var(--ink-soft); line-height: 1.75; margin-bottom: 1rem; }
  .reassure-body strong { color: var(--ink); }

  /* DARK SECTION */
  .section-dark { background: var(--accent-deep); color: #D3E0D0; }
  .label-light {
    display: inline-block; font-size: .76rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase;
    color: #C3D6C0; background: rgba(255,255,255,.1); padding: .35rem .9rem; border-radius: 100px; margin-bottom: 1rem;
  }
  .dark-title { font-family: 'Lora', serif; font-size: clamp(1.6rem, 3vw, 2.2rem); font-weight: 700; color: #fff; margin-bottom: 2.5rem; }
  .pillars-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; }
  .pillar-box { background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.12); border-radius: var(--radius-lg); padding: 1.75rem 1.4rem; }
  .pillar-icon { font-size: 1.8rem; margin-bottom: 1rem; }
  .pillar-title { font-size: .98rem; font-weight: 700; color: #fff; margin-bottom: .5rem; }
  .pillar-desc { font-size: .84rem; color: #B7C8B4; line-height: 1.6; }

  /* APPROACH */
  .section-mid { background: var(--bg-mid); }
  .approach-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
  .approach-card { background: #fff; border: 1.5px solid var(--line); border-radius: var(--radius); padding: 1.75rem 1.5rem; }
  .approach-card h3 { font-family: 'Lora', serif; font-size: 1.1rem; font-weight: 700; margin-bottom: .6rem; color: var(--accent-deep); }
  .approach-card p { font-size: .88rem; color: var(--ink-soft); line-height: 1.65; }

  /* FINAL CTA */
  .cta-section { background: var(--accent-deep); padding: 6rem 0; text-align: center; }
  .cta-inner { display: flex; flex-direction: column; align-items: center; gap: 1.25rem; max-width: 600px; margin: 0 auto; }
  .cta-title { font-family: 'Lora', serif; font-size: clamp(1.7rem, 4vw, 2.3rem); font-weight: 700; color: #fff; line-height: 1.2; }
  .cta-desc { font-size: 1.02rem; color: #C3D6C0; }
  .cta-fine { font-size: .78rem; color: #8FA48C; margin-top: .5rem; }
  .cta-section .btn-primary { background: #fff; color: var(--accent-deep); border-color: #fff; }
  .cta-section .btn-primary:hover { background: var(--accent-pale); }

  @media (max-width: 880px) {
    .pillars-grid { grid-template-columns: repeat(2, 1fr); }
    .approach-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .pillars-grid { grid-template-columns: 1fr; }
  }
</style>
