---
const title = 'Ritu — Health for Every Season of Life';
const description = 'Three companions for three stages of life: perimenopause and menopause support for women, andropause and midlife vitality for men, and longevity guidance for everyone.';
const SITE_URL = 'https://www.thesecondspring.org';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-video-preview:-1" />
    <link rel="canonical" href={SITE_URL} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,500&family=Work+Sans:wght@400;500;600;700;800&display=optional" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-NK9589CRHZ"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-NK9589CRHZ');
    </script>
  </head>
  <body>

    <div class="topbar">
      <div class="mark">
        <svg viewBox="0 0 32 32" fill="none"><circle cx="16" cy="16" r="15" stroke="#1E1B18" stroke-width="1.3"/><path d="M16 7c3 3 5 5.5 5 9a5 5 0 0 1-10 0c0-3.5 2-6 5-9Z" fill="#1E1B18"/></svg>
        <span>Ritu</span>
      </div>
    </div>

    <div class="hero">
      <span class="kicker">One family, three journeys</span>
      <h1>Health moves in seasons.<br/>Which one are you in?</h1>
      <p>Three companions, each built for a different stage of life, sharing one standard of care.</p>
    </div>

    <div class="doors">

      <a class="door door--women" href="/spring">
        <div class="door-top">
          <div class="door-icon"><svg viewBox="0 0 32 32"><path d="M16 4C21 9 25 12 25 18C25 23.5 21 27 16 27C11 27 7 23.5 7 18C7 12 11 9 16 4Z" fill="#D46E86"/><circle cx="16" cy="18" r="4" fill="#FFFFFF"/></svg></div>
          <div class="door-for">For Women</div>
        </div>
        <div class="door-season">Spring</div>
        <div class="door-name">The Second Spring</div>
        <p class="door-desc">Perimenopause and menopause support for Indian women. Symptoms explained, real community, and a free symptom check.</p>
        <div class="door-enter">Enter The Second Spring <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></div>
      </a>

      <a class="door door--men" href="/wind">
        <div class="door-top">
          <div class="door-icon"><svg viewBox="0 0 32 32" fill="none"><path d="M6 20c4-8 8-12 10-12s6 4 10 12" stroke="#FFFFFF" stroke-width="1.6" stroke-linecap="round"/><path d="M6 24c4-6 8-9 10-9s6 3 10 9" stroke="#FFFFFF" stroke-width="1.6" stroke-linecap="round" opacity=".5"/></svg></div>
          <div class="door-for">For Men</div>
        </div>
        <div class="door-season">Wind</div>
        <div class="door-name">Second Wind</div>
        <p class="door-desc">Andropause and age-related testosterone decline in Indian men. Energy, mood, strength, and libido, explained in plain language.</p>
        <div class="door-enter">Enter Second Wind <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></div>
      </a>

      <a class="door door--long" href="/longevity">
        <div class="door-top">
          <div class="door-icon"><svg viewBox="0 0 32 32" fill="none"><path d="M16 4C21 4 25 9 25 15C25 22 21 27 16 27C11 27 7 22 7 15C7 9 11 4 16 4Z" fill="#2F5D44"/><path d="M16 12V27" stroke="#F4F8F3" stroke-width="1.3"/></svg></div>
          <div class="door-for">For Everyone</div>
        </div>
        <div class="door-season">Evergreen</div>
        <div class="door-name">Longevity</div>
        <p class="door-desc">Long-term vitality for every stage of life. Food, Ayurveda, and daily habits that actually hold up over decades.</p>
        <div class="door-enter">Enter Longevity <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></div>
      </a>

    </div>

    <div class="foot">
      <span>Ritu</span><span class="sep">·</span><span>Care that knows what season you're in</span>
    </div>

  </body>
</html>

<style>
  :root {
    --paper: #FAF7F3;
    --ink: #1E1B18;
    --ink-soft: #6B655F;

    --women-bg: #FFFFFF;
    --women-pale: #FDF0F3;
    --women-accent-deep: #B85268;
    --women-ink: #2B2226;

    --men-bg: #111111;
    --men-line: #3A3A3A;
    --men-ink: #F2F2F0;

    --long-bg: #F4F8F3;
    --long-accent: #2F5D44;
    --long-accent-deep: #1F4530;
    --long-ink: #1B2A20;
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; -webkit-font-smoothing: antialiased; }
  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: 'Work Sans', -apple-system, sans-serif;
  }

  .topbar {
    display: flex; align-items: center; justify-content: center;
    max-width: 1180px; margin: 0 auto;
    padding: 1.9rem 1.75rem 0;
  }
  .mark { display: flex; align-items: center; gap: .55rem; }
  .mark svg { width: 26px; height: 26px; flex-shrink: 0; }
  .mark span {
    font-family: 'Fraunces', serif; font-weight: 600; font-size: 1.15rem;
    letter-spacing: .01em; color: var(--ink);
  }

  .hero {
    max-width: 760px; margin: 0 auto; text-align: center;
    padding: 3.6rem 1.75rem 3.1rem;
  }
  .kicker {
    display: inline-block; font-size: .72rem; font-weight: 700; letter-spacing: .14em;
    text-transform: uppercase; color: var(--ink-soft); margin-bottom: 1.3rem;
  }
  .hero h1 {
    font-family: 'Fraunces', serif; font-weight: 500; font-style: italic;
    font-size: clamp(1.9rem, 4.6vw, 2.7rem); line-height: 1.22;
    margin: 0 0 1rem; color: var(--ink); text-wrap: balance;
  }
  .hero p {
    font-size: 1.02rem; color: var(--ink-soft); line-height: 1.68;
    max-width: 480px; margin: 0 auto;
  }

  .doors {
    max-width: 1180px; margin: 0 auto;
    padding: 0 1.25rem 5rem;
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.1rem;
  }
  @media (max-width: 880px) {
    .doors { grid-template-columns: 1fr; max-width: 520px; }
  }

  .door {
    position: relative;
    border-radius: 22px;
    padding: 2.6rem 2rem 2.1rem;
    min-height: 420px;
    display: flex; flex-direction: column;
    text-decoration: none;
    overflow: hidden;
    transition: transform .25s ease, box-shadow .25s ease;
    border: 1px solid transparent;
  }
  .door:hover { transform: translateY(-4px); }

  .door-top {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 1.7rem;
  }
  .door-icon {
    width: 40px; height: 40px;
    display: flex; align-items: center; justify-content: center;
  }
  .door-icon svg { width: 100%; height: 100%; }
  .door-for {
    font-size: .68rem; font-weight: 800; letter-spacing: .09em; text-transform: uppercase;
    padding: .38rem .8rem; border-radius: 100px;
  }

  .door-season {
    font-size: .74rem; font-weight: 600; letter-spacing: .1em; text-transform: uppercase;
    margin-bottom: .55rem; opacity: .68;
  }
  .door-name {
    font-family: 'Fraunces', serif; font-weight: 600; font-size: 1.85rem;
    line-height: 1.12; margin-bottom: .85rem; text-wrap: balance;
  }
  .door-desc {
    font-size: .93rem; line-height: 1.62; margin-bottom: auto; padding-bottom: 1.8rem;
  }
  .door-enter {
    display: inline-flex; align-items: center; gap: .5rem;
    font-size: .84rem; font-weight: 700;
    padding-top: 1.1rem; border-top: 1px solid;
  }
  .door-enter svg { width: 15px; height: 15px; transition: transform .2s ease; }
  .door:hover .door-enter svg { transform: translateX(4px); }

  /* Women */
  .door--women {
    background: linear-gradient(165deg, var(--women-bg) 0%, var(--women-pale) 100%);
    border-color: #F5DEE4;
    box-shadow: 0 1px 2px rgba(180,90,110,.05);
  }
  .door--women:hover { box-shadow: 0 20px 40px -18px rgba(180,90,110,.35); }
  .door--women .door-season { color: var(--women-accent-deep); }
  .door--women .door-name { color: var(--women-ink); }
  .door--women .door-desc { color: #6D5A61; }
  .door--women .door-for { background: var(--women-accent-deep); color: #fff; }
  .door--women .door-enter { color: var(--women-accent-deep); border-color: #F0D4DB; }

  /* Men */
  .door--men {
    background: linear-gradient(165deg, #161616 0%, var(--men-bg) 100%);
    border-color: #2A2A2A;
  }
  .door--men:hover { box-shadow: 0 20px 40px -18px rgba(0,0,0,.55); }
  .door--men .door-season { color: #A8A8A8; }
  .door--men .door-name { color: var(--men-ink); }
  .door--men .door-desc { color: #9C9C9C; }
  .door--men .door-for { background: #FFFFFF; color: #111111; }
  .door--men .door-enter { color: #FFFFFF; border-color: var(--men-line); }

  /* Longevity */
  .door--long {
    background: linear-gradient(165deg, #FBFCFA 0%, var(--long-bg) 100%);
    border-color: #D7E5D3;
  }
  .door--long:hover { box-shadow: 0 20px 40px -18px rgba(31,69,48,.28); }
  .door--long .door-season { color: var(--long-accent); }
  .door--long .door-name { color: var(--long-ink); }
  .door--long .door-desc { color: #4C5F52; }
  .door--long .door-for { background: var(--long-accent-deep); color: #fff; }
  .door--long .door-enter { color: var(--long-accent-deep); border-color: #CFE0CA; }

  .foot {
    max-width: 1180px; margin: 0 auto; padding: 0 1.75rem 3rem;
    display: flex; align-items: center; justify-content: center;
    gap: .5rem; font-size: .78rem; color: var(--ink-soft);
  }
  .foot .sep { opacity: .5; }

  @media (prefers-reduced-motion: reduce) {
    .door, .door-enter svg { transition: none; }
  }
</style>
