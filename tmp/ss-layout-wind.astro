---
const SITE_URL = 'https://www.thesecondspring.org';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  structuredData?: any;
  canonical?: string;
}

const {
  title = 'His Midlife – Andropause & Vitality for Indian Men',
  description = 'Testosterone decline, energy, mood, and strength in midlife, explained clearly for Indian men.',
  image = 'https://thesecondspring.org/og-default.jpg',
  structuredData,
  canonical,
} = Astro.props;

const path = Astro.url.pathname;
const isActive = (href: string) => href === '/wind' ? path === '/wind' : path.startsWith(href);

const canonicalPath = path !== '/wind' && path.endsWith('/') ? path.slice(0, -1) : path;
const canonicalUrl = canonical || `${SITE_URL}${canonicalPath}`;

const pageNodes = structuredData
  ? (Array.isArray(structuredData) ? structuredData : [structuredData])
  : [];
const orgNode = {
  '@type': 'Organization',
  '@id': `${SITE_URL}/wind#organization`,
  name: 'His Midlife',
  url: `${SITE_URL}/wind`,
  logo: { '@type': 'ImageObject', url: `${SITE_URL}/favicon-wind.svg` },
  description: "India's private companion for men navigating andropause and midlife hormonal change, honest, science-backed support for Indian men.",
  email: 'thesecondspringofficial@gmail.com',
  areaServed: 'IN',
};
const websiteNode = {
  '@type': 'WebSite',
  '@id': `${SITE_URL}/wind#website`,
  url: `${SITE_URL}/wind`,
  name: 'His Midlife',
  inLanguage: 'en-IN',
  publisher: { '@id': `${SITE_URL}/wind#organization` },
};
const jsonLdGraph = {
  '@context': 'https://schema.org',
  '@graph': [orgNode, websiteNode, ...pageNodes],
};
const jsonLd = JSON.stringify(jsonLdGraph).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="675" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={image} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-video-preview:-1" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:url" content={canonicalUrl} />
    <script type="application/ld+json" set:html={jsonLd} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;700;800;900&family=Work+Sans:wght@400;500;600;700&display=optional" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href="/favicon-wind.svg" />
    <title>{title}</title>
    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-NK9589CRHZ"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-NK9589CRHZ');
    </script>
  </head>
  <body>

    <nav class="navbar" id="navbar">
      <div class="container navbar-inner">
        <a href="/wind" class="brand">
          <svg class="brand-icon" width="26" height="26" viewBox="0 0 32 32" fill="none">
            <path d="M6 20c4-8 8-12 10-12s6 4 10 12" stroke="#111111" stroke-width="2" stroke-linecap="round"/>
