  </body>
</html>

<script>
  const toggle    = document.getElementById('mobile-toggle');
  const links     = document.getElementById('nav-links');
  const iconMenu  = document.getElementById('icon-menu');
  const iconClose = document.getElementById('icon-close');

  function closeMenu() {
    links?.classList.remove('open');
    if (iconMenu)  (iconMenu as HTMLElement).style.display  = 'block';
    if (iconClose) (iconClose as HTMLElement).style.display = 'none';
  }

  toggle?.addEventListener('click', () => {
    const open = links?.classList.toggle('open');
    if (iconMenu)  (iconMenu as HTMLElement).style.display  = open ? 'none'  : 'block';
    if (iconClose) (iconClose as HTMLElement).style.display = open ? 'block' : 'none';
  });

  document.addEventListener('click', (e) => {
    if (toggle && links && !toggle.contains(e.target as Node) && !links.contains(e.target as Node)) {
      closeMenu();
    }
  });

  document.querySelectorAll('.has-dropdown > a').forEach(link => {
    link.addEventListener('click', (e) => {
      if (window.innerWidth <= 768) {
        e.preventDefault();
        const li = link.parentElement as HTMLElement;
        li.classList.toggle('mob-open');
      }
    });
  });
</script>

<style is:global>
  :root {
    --bg:           #FFFFFF;
    --bg-mid:       #F4F4F3;
    --ink:          #111111;
    --ink-soft:     #5C5C5C;
    --ink-muted:    #8A8A8A;
    --line:         #E4E4E4;
    --line-dark:    #2A2A2A;
    --dark:         #111111;
    --dark-mid:     #1C1C1C;
    --radius-sm:    8px;
    --radius:       14px;
    --radius-lg:    22px;
    --nav-h:        68px;
  }
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; -webkit-font-smoothing: antialiased; }
  body {
    font-family: 'Work Sans', system-ui, -apple-system, sans-serif;
    background: var(--bg);
    color: var(--ink);
    line-height: 1.7;
    font-size: 16px;
    min-height: 100vh;
  }
  img { max-width: 100%; height: auto; display: block; }
  a { color: var(--ink); text-decoration: none; }
  .container { max-width: 1160px; margin: 0 auto; padding: 0 1.5rem; }

  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: .5rem;
    font-weight: 700; font-size: .95rem; text-decoration: none; cursor: pointer;
    padding: .8rem 1.75rem; border-radius: var(--radius-sm); border: 1.5px solid transparent;
    transition: transform .15s, background .15s;
  }
  .btn-primary { background: var(--dark); color: #fff; border-color: var(--dark); }
  .btn-primary:hover { transform: translateY(-1px); background: #000; }
  .btn-outline { background: transparent; color: var(--ink); border-color: var(--ink); }
  .btn-outline:hover { background: var(--bg-mid); }
  .btn-lg { padding: 1rem 2.2rem; font-size: 1rem; }

  /* Nav */
  .navbar { border-bottom: 1.5px solid var(--line); position: sticky; top: 0; background: #fff; z-index: 200; }
  .navbar-inner { display: flex; align-items: center; height: var(--nav-h); gap: 1.5rem; }
  .brand { display: flex; align-items: center; gap: .55rem; margin-right: auto; }
  .brand-name { font-family: 'Archivo', sans-serif; font-size: 1.1rem; font-weight: 800; letter-spacing: -.01em; color: var(--ink); }
  .nav-links { display: flex; align-items: center; gap: 1.5rem; list-style: none; }
  .nav-links a { color: var(--ink-soft); font-size: .88rem; font-weight: 600; padding: .5rem .75rem; border-radius: var(--radius-sm); transition: background .15s; }
  .nav-links a:hover, .nav-links a.active { background: var(--bg-mid); color: var(--ink); }
  .nav-links > li > a { display: flex; align-items: center; gap: .3rem; }
  .chevron { transition: transform .2s; flex-shrink: 0; }
  .has-dropdown { position: relative; }
  .dropdown {
    position: absolute; top: 100%; left: 0; margin-top: .5rem;
    background: #fff; border: 1.5px solid var(--line); border-radius: var(--radius);
    box-shadow: 0 12px 32px rgba(0,0,0,.1);
    min-width: 260px; padding: .5rem;
    opacity: 0; visibility: hidden; transform: translateY(-6px);
    transition: opacity .18s, transform .18s, visibility .18s;
    display: flex; flex-direction: column; gap: .1rem;
  }
  .has-dropdown:hover .dropdown, .has-dropdown:focus-within .dropdown { opacity: 1; visibility: visible; transform: translateY(0); }
  .dropdown-item { display: flex; align-items: flex-start; gap: .75rem; padding: .65rem .85rem; border-radius: var(--radius-sm); }
  .dropdown-item:hover { background: var(--bg-mid); }
  .di-icon { font-size: 1.1rem; flex-shrink: 0; margin-top: .1rem; }
  .di-title { display: block; font-weight: 700; font-size: .87rem; color: var(--ink); }
  .di-desc { display: block; font-size: .76rem; color: var(--ink-muted); margin-top: .1rem; }

  .navbar-right { display: flex; align-items: center; gap: 1rem; margin-left: auto; }
  .all-programs-link { font-size: .78rem; font-weight: 600; color: var(--ink-muted); white-space: nowrap; }
  .all-programs-link:hover { color: var(--ink); }
  .navbar-cta { padding: .55rem 1.2rem; font-size: .84rem; }
  @media (max-width: 900px) { .all-programs-link { display: none; } }
  .mobile-toggle { display: none; background: none; border: none; cursor: pointer; padding: .35rem; color: var(--ink); }
  .mob-menu-cta { display: none; }

  /* Footer */
  .footer { background: var(--dark); color: #C9C9C9; padding: 4rem 0 2rem; margin-top: 5rem; }
  .footer-grid { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 3rem; padding-bottom: 3rem; border-bottom: 1px solid var(--line-dark); }
  .footer-brand { font-family: 'Archivo', sans-serif; font-size: 1.3rem; font-weight: 800; color: #fff; margin-bottom: .75rem; }
  .footer-tagline { font-size: 1rem; font-weight: 600; color: #fff; margin-bottom: .5rem; font-style: italic; }
  .footer-sub-tagline { font-size: .88rem; line-height: 1.65; margin-bottom: 1.25rem; }
  .footer-disclaimer { font-size: .78rem; line-height: 1.65; color: #9C9C9C; padding: 1rem; background: var(--dark-mid); border-radius: 8px; border-left: 3px solid #fff; }
  .footer-programs-link { margin-top: 1rem; font-size: .78rem; }
  .footer-programs-link a { color: #9C9C9C; text-decoration: underline; }
  .footer-programs-link a:hover { color: #fff; }
  .footer h4 { color: #fff; font-size: .8rem; font-weight: 700; text-transform: uppercase; letter-spacing: .07em; margin-bottom: .85rem; }
  .footer ul { list-style: none; }
  .footer ul li { margin-bottom: .4rem; }
  .footer ul li a { color: #C9C9C9; font-size: .87rem; }
  .footer ul li a:hover { color: #fff; }
  .footer-bottom { padding-top: 1.5rem; font-size: .82rem; color: #7A7A7A; text-align: center; }

  @media (max-width: 900px) {
    .footer-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 768px) {
    .nav-links {
      display: none; flex-direction: column; align-items: stretch;
      position: absolute; top: var(--nav-h); left: 0; right: 0;
      background: #fff; border-bottom: 2px solid var(--line);
      box-shadow: 0 12px 32px rgba(0,0,0,.14); z-index: 199;
      max-height: calc(100vh - var(--nav-h)); overflow-y: auto;
    }
    .nav-links.open { display: flex; }
    .nav-links > li { width: 100%; border-bottom: 1px solid var(--line); }
    .nav-links > li > a {
      width: 100%; padding: 1rem 1.5rem; font-size: 1rem; font-weight: 600;
      color: var(--ink); border-radius: 0; background: transparent;
    }
    .nav-links > li > a:hover, .nav-links > li > a.active { background: var(--bg-mid); }
    .dropdown {
      display: none; position: static; transform: none; opacity: 1; visibility: visible;
      box-shadow: none; border: none; border-top: 1px solid var(--line);
      background: var(--bg-mid); border-radius: 0; padding: .5rem; margin: 0;
    }
    .has-dropdown.mob-open .dropdown { display: flex; }
    .has-dropdown.mob-open .chevron { transform: rotate(180deg); }
    .mob-menu-cta { display: block; border-bottom: none !important; padding: 1.25rem 1.5rem; }
    .mob-menu-cta-btn { width: 100%; justify-content: center; font-size: 1rem; }
    .mobile-toggle { display: block; }
    .navbar-cta { display: none; }
    .navbar-inner { position: relative; }
  }
  @media (max-width: 640px) {
    .footer-grid { grid-template-columns: 1fr; }
  }
</style>
