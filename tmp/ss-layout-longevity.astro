---
const SITE_URL = 'https://www.thesecondspring.org';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  structuredData?: any;
  canonical?: string;
}

const {
  title = 'Longevity – Natural Vitality for Every Stage of Life',
  description = 'Food, Ayurveda, and daily habits for a longer, steadier life. Practical, evidence-aware, and rooted in Indian tradition.',
  image = 'https://thesecondspring.org/og-default.jpg',
  structuredData,
  canonical,
} = Astro.props;

const path = Astro.url.pathname;
const isActive = (href: string) => href === '/longevity' ? path === '/longevity' : path.startsWith(href);

const canonicalPath = path !== '/longevity' && path.endsWith('/') ? path.slice(0, -1) : path;
const canonicalUrl = canonical || `${SITE_URL}${canonicalPath}`;

const pageNodes = structuredData
  ? (Array.isArray(structuredData) ? structuredData : [structuredData])
  : [];
const orgNode = {
  '@type': 'Organization',
  '@id': `${SITE_URL}/longevity#organization`,
  name: 'Longevity',
  url: `${SITE_URL}/longevity`,
  logo: { '@type': 'ImageObject', url: `${SITE_URL}/favicon-longevity.svg` },
  description: "Practical, India-rooted longevity guidance, food, Ayurveda, and daily habits for a longer, steadier life.",
  email: 'thesecondspringofficial@gmail.com',
  areaServed: 'IN',
};
const websiteNode = {
  '@type': 'WebSite',
  '@id': `${SITE_URL}/longevity#website`,
  url: `${SITE_URL}/longevity`,
  name: 'Longevity',
  inLanguage: 'en-IN',
  publisher: { '@id': `${SITE_URL}/longevity#organization` },
};
const jsonLdGraph = {
  '@context': 'https://schema.org',
  '@graph': [orgNode, websiteNode, ...pageNodes],
};
const jsonLd = JSON.stringify(jsonLdGraph).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="675" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={image} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-video-preview:-1" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:url" content={canonicalUrl} />
    <script type="application/ld+json" set:html={jsonLd} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,500;0,600;0,700;1,500&family=Work+Sans:wght@400;500;600;700&display=optional" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href="/favicon-longevity.svg" />
    <title>{title}</title>
    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-NK9589CRHZ"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-NK9589CRHZ');
    </script>
  </head>
  <body>

    <nav class="navbar">
      <div class="container navbar-inner">
        <a href="/longevity" class="brand">
          <svg class="brand-icon" width="26" height="26" viewBox="0 0 32 32" fill="none">
            <path d="M16 4C21 4 25 9 25 15C25 22 21 27 16 27C11 27 7 22 7 15C7 9 11 4 16 4Z" fill="#2F5D44"/>
            <path d="M16 12V27" stroke="#F4F8F3" stroke-width="1.3"/>
          </svg>
          <span class="brand-name">Longevity</span>
        </a>
        <ul class="nav-links">
          <li><a href="/longevity" class:list={[{ active: isActive('/longevity') && path === '/longevity' }]}>Home</a></li>
          <li class="has-dropdown">
            <a href="/longevity/guide" class:list={[{ active: isActive('/longevity/guide') }]}>
              Guide
              <svg class="chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="6 9 12 15 18 9"/></svg>
            </a>
            <div class="dropdown">
              <a href="/longevity/guide" class="dropdown-item"><span class="di-title">Guide Overview</span><span class="di-desc">Start your learning journey</span></a>
              <a href="/longevity/guide/food" class="dropdown-item"><span class="di-title">Food & Nutrition</span><span class="di-desc">Eating for the long run</span></a>
              <a href="/longevity/guide/movement" class="dropdown-item"><span class="di-title">Movement & Fitness</span><span class="di-desc">What actually extends healthspan</span></a>
              <a href="/longevity/guide/sleep-rhythm" class="dropdown-item"><span class="di-title">Sleep & Rhythm</span><span class="di-desc">Dinacharya and circadian health</span></a>
              <a href="/longevity/guide/mind-stress" class="dropdown-item"><span class="di-title">Mind & Stress</span><span class="di-desc">Why stress ages you faster</span></a>
              <a href="/longevity/guide/ayurveda" class="dropdown-item"><span class="di-title">Ayurvedic Wisdom</span><span class="di-desc">Traditional practices, evaluated</span></a>
            </div>
          </li>
        </ul>
        <a href="/" class="ritu-link">All programs ↗</a>
      </div>
    </nav>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="container footer-grid">
        <div class="footer-about">
          <div class="footer-brand">Longevity</div>
          <p class="footer-tagline">Small habits, decades of difference.</p>
          <p class="footer-sub-tagline">Food, Ayurveda, and daily habits for a longer, steadier life. Information and support, not medical advice.</p>
          <div class="footer-disclaimer">
            This service provides general health information only. It is not a substitute for professional medical advice, diagnosis, or treatment. Always consult your doctor or a qualified healthcare professional.
          </div>
          <p class="footer-ritu-link"><a href="/">Explore our other programs →</a></p>
        </div>
        <div>
          <h4>Talk to Us</h4>
          <ul>
            <li><a href="https://wa.me/919266032660" target="_blank" rel="noopener noreferrer">WhatsApp Us</a></li>
            <li><a href="mailto:thesecondspringofficial@gmail.com">thesecondspringofficial@gmail.com</a></li>
          </ul>
        </div>
      </div>
      <div class="footer-bottom">
        <p>&copy; {new Date().getFullYear()} Longevity. General health information only, not medical advice.</p>
      </div>
    </footer>

  </body>
</html>

<style is:global>
  :root {
    --bg:           #FFFFFF;
    --bg-mid:       #F4F8F3;
    --ink:          #1B2A20;
    --ink-soft:     #52604F;
    --ink-muted:    #869485;
    --line:         #D7E5D3;
    --accent:       #2F5D44;
    --accent-deep:  #1F4530;
    --accent-pale:  #E4EDE2;
    --radius-sm:    8px;
    --radius:       14px;
    --radius-lg:    22px;
    --nav-h:        68px;
  }
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; -webkit-font-smoothing: antialiased; }
  body {
    font-family: 'Work Sans', system-ui, -apple-system, sans-serif;
    background: var(--bg);
    color: var(--ink);
    line-height: 1.7;
    font-size: 16px;
    min-height: 100vh;
  }
  img { max-width: 100%; height: auto; display: block; }
  a { color: var(--accent-deep); text-decoration: none; }
  .container { max-width: 1160px; margin: 0 auto; padding: 0 1.5rem; }

  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: .5rem;
    font-weight: 700; font-size: .95rem; text-decoration: none; cursor: pointer;
    padding: .8rem 1.75rem; border-radius: 99px; border: 1.5px solid transparent;
    transition: transform .15s, background .15s;
  }
  .btn-primary { background: var(--accent-deep); color: #fff; border-color: var(--accent-deep); }
  .btn-primary:hover { transform: translateY(-1px); background: var(--accent); }
  .btn-outline { background: transparent; color: var(--accent-deep); border-color: var(--accent-deep); }
  .btn-outline:hover { background: var(--accent-pale); }
  .btn-lg { padding: 1rem 2.2rem; font-size: 1rem; }

  /* Nav */
  .navbar { border-bottom: 1.5px solid var(--line); position: sticky; top: 0; background: #fff; z-index: 200; }
  .navbar-inner { display: flex; align-items: center; height: var(--nav-h); gap: 1.5rem; }
  .brand { display: flex; align-items: center; gap: .55rem; margin-right: auto; }
  .brand-name { font-family: 'Lora', serif; font-size: 1.15rem; font-weight: 700; letter-spacing: -.01em; color: var(--ink); }
  .nav-links { display: flex; align-items: center; gap: 1.5rem; list-style: none; }
  .nav-links a { color: var(--ink-soft); font-size: .88rem; font-weight: 600; padding: .5rem .75rem; border-radius: var(--radius-sm); transition: background .15s; }
  .nav-links a:hover, .nav-links a.active { background: var(--accent-pale); color: var(--accent-deep); }
  .nav-links > li > a { display: flex; align-items: center; gap: .3rem; }
  .chevron { transition: transform .2s; flex-shrink: 0; }
  .has-dropdown { position: relative; }
  .dropdown {
    position: absolute; top: 100%; left: 0; margin-top: .5rem;
    background: #fff; border: 1.5px solid var(--line); border-radius: var(--radius);
    box-shadow: 0 12px 32px rgba(0,0,0,.1);
    min-width: 260px; padding: .5rem;
    opacity: 0; visibility: hidden; transform: translateY(-6px);
    transition: opacity .18s, transform .18s, visibility .18s;
    display: flex; flex-direction: column; gap: .1rem;
  }
  .has-dropdown:hover .dropdown, .has-dropdown:focus-within .dropdown { opacity: 1; visibility: visible; transform: translateY(0); }
  .dropdown-item { display: block; padding: .65rem .85rem; border-radius: var(--radius-sm); }
  .dropdown-item:hover { background: var(--accent-pale); }
  .di-title { display: block; font-weight: 700; font-size: .87rem; color: var(--ink); }
  .di-desc { display: block; font-size: .76rem; color: var(--ink-muted); margin-top: .1rem; }
  .ritu-link { font-size: .78rem; font-weight: 600; color: var(--ink-muted); }
  .ritu-link:hover { color: var(--accent-deep); }

  /* Footer */
  .footer { background: var(--accent-deep); color: #D3E0D0; padding: 4rem 0 2rem; margin-top: 5rem; }
  .footer-grid { display: grid; grid-template-columns: 2fr 1fr; gap: 3rem; padding-bottom: 3rem; border-bottom: 1px solid rgba(255,255,255,.15); }
  .footer-brand { font-family: 'Lora', serif; font-size: 1.35rem; font-weight: 700; color: #fff; margin-bottom: .75rem; }
  .footer-tagline { font-size: 1rem; font-weight: 600; color: #fff; margin-bottom: .5rem; font-style: italic; }
  .footer-sub-tagline { font-size: .88rem; line-height: 1.65; margin-bottom: 1.25rem; }
  .footer-disclaimer { font-size: .78rem; line-height: 1.65; color: #B7C8B4; padding: 1rem; background: rgba(0,0,0,.15); border-radius: 8px; border-left: 3px solid #fff; }
  .footer-ritu-link { margin-top: 1rem; font-size: .78rem; }
  .footer-ritu-link a { color: #B7C8B4; text-decoration: underline; }
  .footer-ritu-link a:hover { color: #fff; }
  .footer h4 { color: #fff; font-size: .8rem; font-weight: 700; text-transform: uppercase; letter-spacing: .07em; margin-bottom: .85rem; }
  .footer ul { list-style: none; }
  .footer ul li { margin-bottom: .4rem; }
  .footer ul li a { color: #D3E0D0; font-size: .87rem; }
  .footer ul li a:hover { color: #fff; }
  .footer-bottom { padding-top: 1.5rem; font-size: .82rem; color: #8FA48C; text-align: center; }

  @media (max-width: 640px) {
    .footer-grid { grid-template-columns: 1fr; }
    .nav-links { display: none; }
  }
</style>
